#!/bin/sh
# unruly is a fake crumbkit tool for the runner's tests. It describes itself
# with the documents beside it, and each of its commands misbehaves in one
# way that a real tool might. It ignores crumbkit's own flags, which the
# runner adds to every run.
here=$(dirname "$0")

case "$1 $2" in
"--version ")
  echo "unruly 0.1.0"
  ;;
"commands list")
  cat "$here/unruly-commands-list.json"
  ;;
"schemas list")
  echo '{"schema":"unruly/schemas-list/v1","data":[],"truncated":false}'
  ;;
"child panic")
  echo "thread 'main' panicked at src/main.rs:3:5:" >&2
  echo "the catalogue is gone" >&2
  exit 101
  ;;
"child hang")
  # The shell and its sleep both ignore SIGINT and SIGTERM, so only SIGKILL
  # ends them.
  trap '' INT TERM
  echo '{"schema":"unruly/child-hang/v1","data":{"n":1}}'
  echo '{"schema":"unruly/child-hang/v1","data":{"n":2}}'
  sleep 30
  ;;
"child flood")
  printf '%2000s\n' '' | tr ' ' a
  ;;
"child trace")
  echo "{\"schema\":\"unruly/child-trace/v1\",\"data\":{\"traceparent\":\"$TRACEPARENT\"}}"
  ;;
"child pick")
  echo '{"schema":"unruly/child-pick/v1","data":{}}'
  ;;
"child orphan")
  # The background process leaves the child's process group for a session
  # of its own, so no signal to the group reaches it, and it keeps standard
  # output and standard error open after the child exits.
  perl -MPOSIX -e 'POSIX::setsid(); sleep 10' &
  echo '{"schema":"unruly/child-orphan/v1","data":{}}'
  ;;
"child chatter")
  # More lines than the runner's queue holds, then a hang that only
  # SIGKILL ends.
  trap '' INT TERM
  seq 1000
  sleep 30
  ;;
"child nap")
  sleep 0.2
  echo '{"schema":"unruly/child-nap/v1","data":{}}'
  ;;
"child wipe")
  case " $* " in
  *" --dry-run -- bad "*)
    echo "unruly cannot preview a wipe of bad" >&2
    exit 3
    ;;
  *" --dry-run -- slow "*)
    # The preview prints its document, then exits with 0 on SIGINT.
    trap 'exit 0' INT
    echo '{"schema":"unruly/child-wipe/v1","dry_run":true,"data":{}}'
    while :; do sleep 0.01; done
    ;;
  *" --dry-run "*)
    echo '{"schema":"unruly/child-wipe/v1","dry_run":true,"data":{}}'
    ;;
  *)
    echo '{"schema":"unruly/child-wipe/v1","data":{}}'
    ;;
  esac
  ;;
"child adopt")
  # perl replaces the shell, joins the process group of the program that
  # started it, and ignores SIGINT and SIGTERM, so a signal to the child's
  # own group reaches nobody.
  exec perl -e '$| = 1; $SIG{INT} = $SIG{TERM} = "IGNORE";
    setpgrp(0, getpgrp(getppid())) or die "setpgrp: $!";
    print qq({"schema":"unruly/child-adopt/v1","data":{}}\n); sleep 30'
  ;;
"child interrupt")
  # On SIGINT it prints more documents than the runner's queue holds, and
  # then a last line that is no document, and exits with 0.
  trap 'seq 400 | sed "s/.*/{\"schema\":\"unruly\/child-interrupt\/v1\",\"data\":{}}/"; echo interrupted; exit 0' INT
  echo '{"schema":"unruly/child-interrupt/v1","data":{}}'
  while :; do sleep 0.01; done
  ;;
"child linger")
  # The last argument is the number of seconds. The shell and its sleep
  # both ignore SIGINT and SIGTERM, so a stop before then needs SIGKILL.
  for seconds; do :; done
  trap '' INT TERM
  echo "{\"schema\":\"unruly/child-linger/v1\",\"data\":{\"pid\":$$}}"
  sleep "$seconds"
  echo '{"schema":"unruly/child-linger/v1","data":{}}'
  ;;
"child wait")
  # It prints three documents, then waits until SIGINT, on which it exits
  # with 130.
  trap 'exit 130' INT
  for n in 1 2 3; do
    echo "{\"schema\":\"unruly/child-wait/v1\",\"data\":{\"n\":$n}}"
  done
  while :; do sleep 0.01; done
  ;;
"child spew")
  # It prints its process id, then documents until a signal ends it.
  echo "{\"schema\":\"unruly/child-spew/v1\",\"data\":{\"pid\":$$}}"
  while :; do echo '{"schema":"unruly/child-spew/v1","data":{}}'; done
  ;;
"child roster")
  # It lists nothing, and waits until a signal ends it.
  while :; do sleep 0.01; done
  ;;
"child ledger")
  echo "thread 'main' panicked at src/main.rs:9:5:" >&2
  exit 101
  ;;
"child whole" | "child answer" | "child bytes" | "child silent")
  # crumbkit refuses --full on a command whose JSON already holds every
  # field or that prints no result, as a refused command line with exit
  # code 2.
  case " $* " in
  *" --full "*)
    echo '{"schema":"unruly/failure/v1","code":"unruly::cli::usage","message":"--full prints every field of every row, and this command'"'"'s JSON already holds every field","fields":{"argument":"--full"},"recovery":{"kind":"hint","text":"drop --full, because --json already prints the whole result"}}'
    exit 2
    ;;
  esac
  echo '{"schema":"unruly/child-whole/v1","data":{}}'
  ;;
"child rows" | "child said")
  case " $* " in
  *" --full "*)
    echo '{"schema":"unruly/child-rows/v1","data":[{"id":1,"note":"every field"}],"truncated":false}'
    ;;
  *)
    echo "unruly $1 $2 needs --full" >&2
    exit 3
    ;;
  esac
  ;;
"child both" | "child pair" | "child visit")
  echo '{"schema":"unruly/child-both/v1","data":{}}'
  ;;
*)
  echo "unruly does not know $*" >&2
  exit 2
  ;;
esac
