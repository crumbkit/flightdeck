{
  "$schema": "https://unpkg.com/knip@6.43.0/schema.json",
  "ignoreExportsUsedInFile": true,
  "ignoreIssues": { "headless/src/api/generated/**": ["exports", "types"] },
  "workspaces": {
    ".": {
      "project": ["src/**/*.{ts,tsx,css}", "tests/**/*.ts", "scripts/**/*.ts"]
    },
    "headless": {
      "project": ["src/**/*.ts", "*.ts"]
    },
    "react": {
      "project": ["src/**/*.{ts,tsx}", "*.ts"]
    }
  }
}
