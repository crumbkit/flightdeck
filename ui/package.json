{
  "name": "flightdeck-ui",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "dev": "vite",
    "lint": "biome ci --error-on-warnings .",
    "fix": "biome check --write .",
    "typecheck": "tsc",
    "knip": "knip",
    "test": "vitest run",
    "build": "vite build",
    "bundle": "test -z \"$(git status --porcelain --untracked-files=all --ignored -- dist | tee /dev/stderr)\"",
    "size": "size-limit",
    "acceptance": "playwright test"
  },
  "dependencies": {
    "@tanstack/react-query": "5.107.1",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "lucide-react": "1.71.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.6",
    "@playwright/test": "1.65.0",
    "@size-limit/file": "14.3.0",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.9",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "jsdom": "31.0.0",
    "knip": "6.44.2",
    "size-limit": "14.3.0",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  },
  "size-limit": [
    {
      "name": "first load",
      "path": [
        "dist/index.html",
        "dist/assets/app.js",
        "dist/assets/shared.js",
        "dist/assets/rolldown-runtime.js",
        "dist/assets/index.css",
        "dist/fonts/*.woff2"
      ],
      "limit": "246 kB"
    },
    {
      "name": "every file",
      "path": [
        "dist/**/*"
      ],
      "limit": "264 kB"
    }
  ]
}
